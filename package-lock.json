{
    "name": "capskit",
    "version": "0.0.0",
    "lockfileVersion": 3,
    "requires": true,
    "packages": {
        "": {
            "name": "capskit",
            "version": "0.0.0",
            "workspaces": [
                "packages/*",
                "examples/*"
            ]
        },
        "examples/accounting-platform": {
            "version": "0.0.0",
            "dependencies": {
                "@capskit/core": "*",
                "@capskit/system": "*"
            }
        },
        "examples/inventory-platform": {
            "version": "0.0.0",
            "dependencies": {
                "@capskit/core": "*",
                "@capskit/system": "*"
            }
        },
        "examples/trading-platform": {
            "version": "0.0.0",
            "extraneous": true,
            "dependencies": {
                "@capskit/core": "*",
                "@capskit/system": "*"
            }
        },
        "node_modules/@capskit/core": {
            "resolved": "packages/core",
            "link": true
        },
        "node_modules/@capskit/system": {
            "resolved": "packages/system-capsules",
            "link": true
        },
        "node_modules/@capskit/types": {
            "resolved": "packages/types",
            "link": true
        },
        "node_modules/accounting-platform": {
            "resolved": "examples/accounting-platform",
            "link": true
        },
        "node_modules/inventory-platform": {
            "resolved": "examples/inventory-platform",
            "link": true
        },
        "packages/core": {
            "name": "@capskit/core",
            "version": "0.0.0"
        },
        "packages/system-capsules": {
            "name": "@capskit/system",
            "version": "0.0.0"
        },
        "packages/types": {
            "name": "@capskit/types",
            "version": "0.0.0"
        }
    }
}
