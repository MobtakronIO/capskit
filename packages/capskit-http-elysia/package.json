{
  "name": "@mobtakronio/capskit-http-elysia",
  "version": "0.1.0",
  "description": "Elysia HTTP adapter for CapsKit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "elysia": "^1.4.27"
  },
  "peerDependencies": {
    "@mobtakronio/capskit": "^0.3.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "@mobtakronio/capskit": "*"
  }
}
