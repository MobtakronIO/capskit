{
  "name": "@mobtakronio/capskit-vue",
  "version": "0.1.0",
  "description": "Vue composables for CapsKit client",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.js" }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": ">=3.0.0",
    "@mobtakronio/capskit-client": ">=0.1.0"
  },
  "devDependencies": {
    "vue": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
