{
  "name": "@mobtakronio/elysia",
  "version": "0.5.0",
  "description": "Elysia adapter for CapsKit — HTTP and WebSocket transport in one package",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.ts",
      "import": "./dist/websocket/index.js",
      "require": "./dist/websocket/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "keywords": [
    "capskit",
    "elysia",
    "http",
    "websocket",
    "adapter",
    "router"
  ],
  "peerDependencies": {
    "@mobtakronio/capskit": "^0.5.0",
    "elysia": "^1.4.27"
  },
  "peerDependenciesMeta": {
    "@mobtakronio/capskit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mobtakronio/capskit": "*",
    "elysia": "^1.4.27",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
