{
  "name": "@mobtakronio/capskit-drizzle",
  "version": "0.1.0",
  "description": "Drizzle ORM capsule for capskit - Postgres and SQLite support",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "drizzle-orm": "^0.40.0",
    "@neondatabase/serverless": "^0.10.0",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0"
  },
  "peerDependencies": {
    "@mobtakronio/capskit": ">=0.3.0"
  }
}
