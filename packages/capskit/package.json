{
  "name": "@mobtakronio/capskit",
  "version": "0.4.0",
  "description": "The Universal Capability Kernel - A framework-agnostic runtime for pure business logic.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lint/no-direct-call": {
      "types": "./dist/lint/no-direct-call.d.ts",
      "import": "./dist/lint/no-direct-call.js",
      "require": "./dist/lint/no-direct-call.cjs"
    },
    "./lint/no-cap-meta-missing": {
      "types": "./dist/lint/no-cap-meta-missing.d.ts",
      "import": "./dist/lint/no-cap-meta-missing.js",
      "require": "./dist/lint/no-cap-meta-missing.cjs"
    },
    "./lint/no-cap-logic-missing": {
      "types": "./dist/lint/no-cap-logic-missing.d.ts",
      "import": "./dist/lint/no-cap-logic-missing.js",
      "require": "./dist/lint/no-cap-logic-missing.cjs"
    },
    "./lint/caps-registry-required": {
      "types": "./dist/lint/caps-registry-required.d.ts",
      "import": "./dist/lint/caps-registry-required.js",
      "require": "./dist/lint/caps-registry-required.cjs"
    },
    "./lint": "./dist/lint/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint eslint.config.js",
    "test": "vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@mobtakronio/elysia": "^0.2.0",
    "@types/node": "^25.4.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "elysia": "^1.4.27",
    "eslint": "^10.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.6",
    "vue": "^3.5.30"
  },
  "dependencies": {
    "@mobtakronio/elysia": "^0.2.0",
    "@neondatabase/serverless": "^1.0.2",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.2",
    "semver": "^7.7.4"
  }
}
