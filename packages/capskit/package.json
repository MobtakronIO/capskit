{
  "name": "@mobtakronio/capskit",
  "version": "0.5.7",
  "description": "The Universal Capability Kernel - A framework-agnostic runtime for pure business logic.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lint/max-cap-lines": {
      "types": "./dist/lint/max-cap-lines.d.ts",
      "import": "./dist/lint/max-cap-lines.js",
      "require": "./dist/lint/max-cap-lines.cjs"
    },
    "./lint/max-cap-steps": {
      "types": "./dist/lint/max-cap-steps.d.ts",
      "import": "./dist/lint/max-cap-steps.js",
      "require": "./dist/lint/max-cap-steps.cjs"
    },
    "./lint/no-cap-imports-cap": {
      "types": "./dist/lint/no-cap-imports-cap.d.ts",
      "import": "./dist/lint/no-cap-imports-cap.js",
      "require": "./dist/lint/no-cap-imports-cap.cjs"
    },
    "./lint/no-import-violation": {
      "types": "./dist/lint/no-import-violation.d.ts",
      "import": "./dist/lint/no-import-violation.js",
      "require": "./dist/lint/no-import-violation.cjs"
    },
    "./lint/require-cap-meta": {
      "types": "./dist/lint/require-cap-meta.d.ts",
      "import": "./dist/lint/require-cap-meta.js",
      "require": "./dist/lint/require-cap-meta.cjs"
    },
    "./lint/require-cap-handler": {
      "types": "./dist/lint/require-cap-handler.d.ts",
      "import": "./dist/lint/require-cap-handler.js",
      "require": "./dist/lint/require-cap-handler.cjs"
    },
    "./lint/no-class-in-cap": {
      "types": "./dist/lint/no-class-in-cap.d.ts",
      "import": "./dist/lint/no-class-in-cap.js",
      "require": "./dist/lint/no-class-in-cap.cjs"
    },
    "./lint/no-index-signature": {
      "types": "./dist/lint/no-index-signature.d.ts",
      "import": "./dist/lint/no-index-signature.js",
      "require": "./dist/lint/no-index-signature.cjs"
    },
    "./lint/banned-words": {
      "types": "./dist/lint/banned-words.d.ts",
      "import": "./dist/lint/banned-words.js",
      "require": "./dist/lint/banned-words.cjs"
    },
    "./lint": "./dist/lint/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint eslint.config.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}